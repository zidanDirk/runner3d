{
  "compilerOptions": {
    "target": "ES2022",
    "lib": [
      "ES2022",
      "DOM"
    ],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "resolveJsonModule": true,
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "skipLibCheck": true,
    "verbatimModuleSyntax": true,
    "noEmit": true,
    "types": [
      "node"
    ]
  },
  "include": [
    "playwright.loading.config.ts",
    "tests/loading",
    "vite.config.ts",
    "playwright.config.ts",
    "playwright.production.config.ts",
    "tests/e2e",
    "tests/production",
    "src/test-hooks.d.ts",
    "scripts/balance",
    "scripts/agent",
    "playwright.beta.config.ts",
    "tests/beta",
    "playwright.release.config.ts",
    "tests/release"
  ]
}
